# 이 파일을 .env 로 복사한 뒤 값을 채워주세요.

# PostgreSQL (권장) — docker compose up -d 로 로컬 DB 실행
# 호스트 포트는 55432 (docker-compose.yml). 기존 로컬 PostgreSQL(5432/5433) 과 충돌을 피한다.
DATABASE_URL="postgresql://workflow:workflow@127.0.0.1:55432/workflow?schema=public"

# openssl rand -base64 32 등으로 생성한 임의의 문자열
AUTH_SECRET=""
